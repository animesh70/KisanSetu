PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Microsoft Azure Speech (server-side only; never expose these as VITE_* variables)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Standalone CropVision screening (server-side only; never expose as VITE_* variables)
# Missing configuration returns a safe 503; cold starts may require the 60-second timeout.
CROP_VISION_URL=
CROP_VISION_API_KEY=
CROP_VISION_TIMEOUT_MS=60000
# Shared Logistics geospatial matching (backend-only)
MONGODB_URI=
MONGODB_DB_NAME=kisansetu
SHARED_LOGISTICS_RADIUS_KM=15
SHARED_LOGISTICS_MAX_MATCHES=20

# P2P Equipment Sharing uses Mongoose with the same private MongoDB connection.
# Demo listings are inserted only when the equipment collection is empty.
EQUIPMENT_DEMO_SEED_ENABLED=true

# Direct Marketplace / escrow economics
PLATFORM_FEE_PERCENT=1.5
ESCROW_PROVIDER=demo
ESCROW_DEMO_OTP_EXPOSE=true

# Optional Razorpay Route integration (use TEST keys first).
# Route supports held transfers; linked accounts are required before real split settlement.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LINKED_ACCOUNTS_JSON={}
