PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Microsoft Azure Speech (server-side only; never expose these as VITE_* variables)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# OpenAI vision screening (server-side only; never expose as a VITE_* variable)
# Crop-photo analysis returns a safe 503 response until a real API key is configured.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_TIMEOUT_MS=20000
